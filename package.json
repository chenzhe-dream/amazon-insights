{
  "name": "amz-lens-competitor-intelligence",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:lan": "vinext dev --hostname 0.0.0.0",
    "build": "vinext build",
    "start": "node ./scripts/team-prod-server.mjs",
    "serve:team": "npm run build && npm run start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "review:sync": "node ./scripts/build-sorftime-review-analysis.mjs",
    "review:sync:force": "node ./scripts/build-sorftime-review-analysis.mjs --force",
    "review:sellersprite:sync": "node ./scripts/build-sellersprite-review-analysis.mjs",
    "review:sellersprite:sync:force": "node ./scripts/build-sellersprite-review-analysis.mjs --force",
    "sales:sync": "node ./scripts/build-sorftime-sales-trend.mjs",
    "sales:sync:force": "node ./scripts/build-sorftime-sales-trend.mjs --force",
    "child-sales:sync": "node ./scripts/build-sorftime-child-sales.mjs",
    "child-sales:sync:force": "node ./scripts/build-sorftime-child-sales.mjs --force",
    "price-strategy:sync": "node ./scripts/build-sorftime-price-strategy.mjs",
    "price-strategy:sync:force": "node ./scripts/build-sorftime-price-strategy.mjs --force",
    "fba:sync": "node ./scripts/build-sorftime-fba-fee.mjs",
    "fba:sync:force": "node ./scripts/build-sorftime-fba-fee.mjs --force",
    "listing:sync": "node ./scripts/build-sorftime-listing-content.mjs",
    "listing:sync:force": "node ./scripts/build-sorftime-listing-content.mjs --force",
    "variant12m:sync": "node ./scripts/build-variant-12m-trend.mjs",
    "variant12m:sync:force": "node ./scripts/build-variant-12m-trend.mjs --force",
    "category:sync": "node ./scripts/build-sorftime-category-trend.mjs",
    "category:sync:force": "node ./scripts/build-sorftime-category-trend.mjs --force",
    "keywords:sync": "node ./scripts/build-sif-keyword-analysis.mjs",
    "keywords:sync:force": "node ./scripts/build-sif-keyword-analysis.mjs --force",
    "alexa:login": "node ./scripts/save-amazon-auth.mjs",
    "alexa:sync": "node ./scripts/run-alexa-voc-capture.mjs",
    "alexa:sync:chrome": "node ./scripts/run-alexa-voc-capture-chrome.mjs",
    "alexa:import": "node ./scripts/import-alexa-voc-from-chrome.mjs",
    "alexa:paste": "node ./scripts/import-alexa-voc-from-text.mjs",
    "alexa:chrome:cdp": "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-chrome-cdp-profile.ps1",
    "sync:asins": "node ./scripts/run-asin-sync-job.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
