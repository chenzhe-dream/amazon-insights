# Copy the required values into the protected external file:
# C:\Users\EDY\Amazon-Product-Opportunity-Insights.runtime\formal-stack.env
# Never place real secrets in this tracked example.
# Formal services read this external file; editing newly created User environment variables does not update a running formal stack.

AGENT_DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:58258/<database>
AGENT_VOC_LOCAL_FAKE=0
WEB_HOST=0.0.0.0
WEB_PORT=31900
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=31901
AGENT_SERVICE_INTERNAL_URL=http://127.0.0.1:31901
AGENT_SERVICE_TRUSTED_ORIGINS=http://127.0.0.1:31900,http://<LAN-IP>:31900
AGENT_AUTH_ALLOW_INSECURE_PRIVATE_NETWORK_COOKIE=1
AGENT_DATA_ROOT=C:\Users\EDY\Amazon-Product-Opportunity-Insights.runtime\data
AGENT_RUNTIME_ROOT=C:\Users\EDY\Amazon-Product-Opportunity-Insights.runtime\runtime
XYDC_MCP_TOKEN=
XYDC_COORDINATION_ROOT=C:\Users\EDY\Amazon-Product-Opportunity-Insights.runtime\xydc-coordination

# DingTalk development application. Use a separate application in production.
DINGTALK_ENABLED=0
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_LOCAL_ORGANIZATION_ID=
DINGTALK_REDIRECT_URI=http://127.0.0.1:31900/api/auth/dingtalk/callback
