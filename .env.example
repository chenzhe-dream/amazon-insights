# Shared by the vinext Web proxy and Node Agent Service.
# Use one long random value for AGENT_SERVICE_PROXY_TOKEN in both processes.
WEB_HOST=127.0.0.1
WEB_PORT=3001
AGENT_SERVICE_INTERNAL_URL=http://127.0.0.1:3100
AGENT_SERVICE_PROXY_TOKEN=replace-with-one-long-random-local-token
AGENT_SERVICE_TRUSTED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# Node Agent Service listener and request policy.
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=3100
AGENT_SERVICE_BODY_LIMIT_BYTES=1048576
AGENT_SERVICE_REQUEST_DEADLINE_MS=10000

# Storage.
# Empty AGENT_DATABASE_URL selects SQLite via AGENT_SQLITE_PATH.
# Non-empty AGENT_DATABASE_URL must be postgres:// or postgresql://; invalid
# values fail closed during Agent Service startup.
AGENT_SQLITE_PATH=./data/agent-service.sqlite
AGENT_SQLITE_BUSY_TIMEOUT_MS=5000
AGENT_DATABASE_URL=

# Local fixture smoke only. Do not set these in production.
AGENT_AUTH_ALLOW_ANONYMOUS_LOOPBACK=0
AGENT_AUTH_ALLOW_INSECURE_LOOPBACK_COOKIE=0
# Authenticated private-LAN HTTP development only. The Agent and database
# remain loopback-only; production and unsafe origin/bind matrices fail closed.
AGENT_AUTH_ALLOW_INSECURE_PRIVATE_NETWORK_COOKIE=0
AGENT_VOC_LOCAL_FAKE=0

# Optional DingTalk authentication. Never commit the real Client Secret.
DINGTALK_ENABLED=0
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_LOCAL_ORGANIZATION_ID=
DINGTALK_REDIRECT_URI=

# Optional provider/connector capabilities. Do not commit real secrets.
OPENAI_API_KEY=
SIF_MCP_SECRET=
SORFTIME_MCP_KEY=
SELLERSPRITE_SECRET_KEY=
