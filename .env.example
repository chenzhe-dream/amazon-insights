# Shared by the vinext Web proxy and Node Agent Service.
# Use one long random value for AGENT_SERVICE_PROXY_TOKEN in both processes.
WEB_HOST=127.0.0.1
WEB_PORT=3001
AGENT_SERVICE_INTERNAL_URL=http://127.0.0.1:3100
AGENT_SERVICE_PROXY_TOKEN=replace-with-one-long-random-local-token
AGENT_SERVICE_TRUSTED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# Node Agent Service listener and request policy.
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=3100
AGENT_SERVICE_BODY_LIMIT_BYTES=1048576
AGENT_SERVICE_REQUEST_DEADLINE_MS=10000

# Storage.
# Empty AGENT_DATABASE_URL selects SQLite via AGENT_SQLITE_PATH.
# Non-empty AGENT_DATABASE_URL must be postgres:// or postgresql://; invalid
# values fail closed during Agent Service startup.
AGENT_SQLITE_PATH=./data/agent-service.sqlite
AGENT_SQLITE_BUSY_TIMEOUT_MS=5000
AGENT_DATABASE_URL=

# Local fixture smoke only. Do not set these in production.
AGENT_AUTH_ALLOW_ANONYMOUS_LOOPBACK=0
AGENT_AUTH_ALLOW_INSECURE_LOOPBACK_COOKIE=0
# Authenticated private-LAN HTTP development only. The Agent and database
# remain loopback-only; production and unsafe origin/bind matrices fail closed.
AGENT_AUTH_ALLOW_INSECURE_PRIVATE_NETWORK_COOKIE=0
AGENT_VOC_LOCAL_FAKE=0

# Optional DingTalk authentication. Never commit the real Client Secret.
DINGTALK_ENABLED=0
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_LOCAL_ORGANIZATION_ID=
DINGTALK_REDIRECT_URI=

# Optional user-presence access. Leave blank to deny; configure only the
# designated primary account and exact verified personal DingTalk binding.
AGENT_USER_PRESENCE_ORGANIZATION_ID=
AGENT_USER_PRESENCE_PRIMARY_USER_ID=
AGENT_USER_PRESENCE_PRIMARY_EMAIL=
AGENT_USER_PRESENCE_DINGTALK_USER_ID=
AGENT_USER_PRESENCE_DINGTALK_CORP_ID=
AGENT_USER_PRESENCE_DINGTALK_SUBJECT_ID=

# Optional provider/connector capabilities. Do not commit real secrets.
# VOC positioning queue/retry wait deadline (ms), independent of provider timeout.
# Range 1000–3600000; pending/passed durable work and report recovery are protected.
AGENT_VOC_QUEUE_TIMEOUT_MS=300000
OPENAI_API_KEY=

# Optional independent image analysis route. Defaults preserve OpenAI chat behavior.
# A custom base URL or anthropic-messages protocol requires a dedicated image key;
# text/VOC credentials are never copied to an explicitly separate route.
AGENT_IMAGE_REMARK_PROTOCOL=
AGENT_IMAGE_REMARK_BASE_URL=
AGENT_IMAGE_REMARK_API_KEY=
AGENT_IMAGE_REMARK_MODEL=
# Optional: url (default), or base64 for anthropic-messages; Amazon JPEGs only, <=5 MiB.
AGENT_IMAGE_REMARK_INPUT_MODE=
SIF_MCP_SECRET=
SORFTIME_MCP_KEY=
SELLERSPRITE_SECRET_KEY=

# Optional XYDC enrichment. Never commit a real token.
XYDC_MCP_TOKEN=
# Explicit absolute directory shared by same-host tasks using the same XYDC credential.
# This coordination directory is independent of AGENT_DATA_ROOT and AGENT_RUNTIME_ROOT.
# Example placeholder only: C:/your-private-runtime/xydc-coordination
XYDC_COORDINATION_ROOT=
